# SUNNAH_API_KEY: Optional API key for live Sunnah.com Hadith queries (https://sunnah.com/developers).
# Copy this file to .env and set your key if you have been granted a Sunnah.com API key.
# When left as the default placeholder, SalahMate uses its verified offline bundled Hadith collection.
SUNNAH_API_KEY=OPTIONAL_SUNNAH_API_KEY
