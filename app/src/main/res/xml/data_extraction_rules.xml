<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="salahmate_offline.db" />
        <include domain="file" path="datastore/" />
        <exclude domain="sharedpref" path="salahmate_alarm_dedup.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="salahmate_offline.db" />
        <include domain="file" path="datastore/" />
        <exclude domain="sharedpref" path="salahmate_alarm_dedup.xml" />
    </device-transfer>
</data-extraction-rules>
